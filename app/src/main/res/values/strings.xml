    <!-- Einrichtung -->
    <string name="setup_title">Einrichtung</string>
    <string name="setup_intro">Das Ambilight läuft auch ohne diese Freigaben. Sie schalten Komfortfunktionen frei. Erteilen geht, sofern der TV es anbietet, über die TV-Einstellungen, sonst einmalig per ADB vom PC oder einer ADB-App am Handy.</string>
    <string name="setup_all_granted">Alle Freigaben erteilt.</string>
    <plurals name="setup_missing">
        <item quantity="one">%1$d Freigabe fehlt</item>
        <item quantity="other">%1$d Freigaben fehlen</item>
    </plurals>
    <string name="setup_all_title">Alle Freigaben mit einem Befehl</string>
    <string name="setup_all_hint">Am PC im selben Netz: zuerst „adb connect &lt;TV-IP&gt;:5555“, dann diesen Befehl. Anschließend in den Einstellungen „Autostart“ einschalten.</string>
    <string name="setup_back">Zurück</string>
    <string name="perm_granted">✓ Erteilt</string>
    <string name="perm_missing">Fehlt</string>
    <string name="perm_open">TV-Einstellung öffnen</string>
    <string name="perm_adb">ADB: adb shell %1$s</string>
    <string name="perm_settings_missing">Diese Einstellung gibt es am TV nicht, bitte per ADB freigeben.</string>
    <string name="perm_capture_title">Ohne Freigabe-Dialog starten</string>
    <string name="perm_capture_desc">Bildschirmaufnahme ohne „Jetzt starten“-Bestätigung. Nötig, wenn der Dialog bei TCL gar nicht erscheint, für Autostart und für den Start aus Home Assistant.</string>
    <string name="perm_media_title">Pause-Erkennung</string>
    <string name="perm_media_desc">Erkennt Wiedergabe und Pause (auch Netflix &amp; Co): Pausenlicht und Standardlicht bis zur Wiedergabe. Benachrichtigungen werden nicht gelesen.</string>
    <string name="perm_usage_title">App-Erkennung</string>
    <string name="perm_usage_desc">Erkennt die App im Vordergrund: App-Profile, z. B. Netflix sofort Ersatzfarben.</string>
    <string name="perm_overlay_title">Autostart</string>
    <string name="perm_overlay_desc">Erlaubt, die Bildschirmaufnahme nach Neustart oder Standby selbst neu zu starten. Zusätzlich in den Einstellungen „Autostart“ einschalten.</string>

