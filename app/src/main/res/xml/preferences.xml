<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:selectable="false"
        app:iconSpaceReserved="false"
        app:summary="@string/settings_note" />

    <PreferenceCategory app:title="@string/cat_mqtt" app:iconSpaceReserved="false">
        <EditTextPreference app:key="mqtt_host" app:title="@string/pref_host" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="mqtt_port" app:title="@string/pref_port" app:defaultValue="1883" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="mqtt_tls" app:title="@string/pref_tls" app:summary="@string/pref_tls_summary"
            app:defaultValue="false" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="mqtt_user" app:title="@string/pref_user" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="mqtt_password" app:title="@string/pref_password" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_z2m" app:iconSpaceReserved="false">
        <EditTextPreference app:key="z2m_base_topic" app:title="@string/pref_base_topic" app:defaultValue="zigbee2mqtt" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="light_left" app:title="@string/pref_light_left" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="light_right" app:title="@string/pref_light_right" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_picture" app:iconSpaceReserved="false">
        <SeekBarPreference app:key="update_rate" app:title="@string/pref_rate" app:summary="@string/pref_rate_summary"
            app:min="1" android:max="10" app:defaultValue="5" app:showSeekBarValue="true" app:iconSpaceReserved="false"
           />
        <SeekBarPreference app:key="transition_ms" app:title="@string/pref_transition" app:summary="@string/pref_transition_summary"
            app:min="0" android:max="2000" app:seekBarIncrement="50" app:defaultValue="0" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <SeekBarPreference app:key="zone_width" app:title="@string/pref_zone"
            app:min="5" android:max="50" app:defaultValue="30" app:showSeekBarValue="true" app:iconSpaceReserved="false"
           />
        <SeekBarPreference app:key="smoothing" app:title="@string/pref_smoothing"
            app:min="0" android:max="90" app:seekBarIncrement="5" app:defaultValue="30" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <SeekBarPreference app:key="saturation" app:title="@string/pref_saturation"
            app:min="50" android:max="250" app:seekBarIncrement="5" app:defaultValue="130" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <SeekBarPreference app:key="brightness_min" app:title="@string/pref_min_brightness"
            app:min="1" android:max="254" app:seekBarIncrement="5" app:defaultValue="10" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <SeekBarPreference app:key="brightness_max" app:title="@string/pref_max_brightness"
            app:min="1" android:max="254" app:seekBarIncrement="5" app:defaultValue="254" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_black" app:iconSpaceReserved="false">
        <ListPreference app:key="black_mode" app:title="@string/pref_black_mode"
            app:entries="@array/black_mode_entries" app:entryValues="@array/black_mode_values"
            app:defaultValue="COLOR" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <ListPreference app:key="black_color_left" app:title="@string/pref_black_color_left"
            app:entries="@array/fixed_color_entries" app:entryValues="@array/fixed_color_values"
            app:defaultValue="warm" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="black_color_left_custom" app:title="@string/pref_black_custom_left" app:iconSpaceReserved="false" />
        <ListPreference app:key="black_color_right" app:title="@string/pref_black_color_right"
            app:entries="@array/fixed_color_entries" app:entryValues="@array/fixed_color_values"
            app:defaultValue="warm" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="black_color_right_custom" app:title="@string/pref_black_custom_right" app:iconSpaceReserved="false" />
        <SeekBarPreference app:key="black_brightness" app:title="@string/pref_black_brightness"
            app:min="1" android:max="254" app:seekBarIncrement="5" app:defaultValue="80" app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_behavior" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="off_on_standby" app:title="@string/pref_off_standby" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="off_on_stop" app:title="@string/pref_off_stop" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="autostart" app:title="@string/pref_autostart" app:summary="@string/pref_autostart_summary"
            app:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_ha" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="ha_discovery" app:title="@string/pref_ha_discovery" app:summary="@string/pref_ha_discovery_summary"
            app:defaultValue="true" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="ha_prefix" app:title="@string/pref_ha_prefix" app:defaultValue="homeassistant" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="app_topic" app:title="@string/pref_app_topic" app:defaultValue="tv-ambilight" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
